rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasPrivateProfile() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['OWNER', 'USER'];
    }

    function isOwner() {
      return hasPrivateProfile()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'OWNER';
    }

    match /{allPaths=**} {
      allow read: if hasPrivateProfile();
      allow write: if hasPrivateProfile()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*');
      allow delete: if isOwner();
    }
  }
}