rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasPrivateProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['OWNER', 'USER'];
    }

    function isOwner() {
      return hasPrivateProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER';
    }

    function isCreator() {
      return hasPrivateProfile() && resource.data.creatorId == request.auth.uid;
    }

    match /users/{userId} {
      // Users need to read their own document while deciding whether the
      // first-login profile must be created.
      allow read: if hasPrivateProfile() || (signedIn() && request.auth.uid == userId);
      // A first-time Firebase account may create only its own, minimal USER
      // profile. OWNER profiles must still be provisioned administratively.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'USER'
        && request.resource.data.keys().hasOnly(['role', 'email'])
        && (!request.resource.data.keys().hasAny(['email'])
          || request.resource.data.email is string);
      allow update: if isOwner() || (hasPrivateProfile() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if hasPrivateProfile();
      allow write: if isOwner();
    }

    match /messages/{messageId} {
      // Only authenticated users with a private profile may create messages,
      // and the senderId must match the authenticated UID so clients cannot
      // impersonate other users. Basic validation of fields is enforced.
      allow read: if hasPrivateProfile();
      allow create: if hasPrivateProfile()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.text is string
        && request.resource.data.deliveredTo is list
        && request.resource.data.readBy is list;
      allow update: if hasPrivateProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredTo', 'readBy'])
        && request.resource.data.deliveredTo is list
        && request.resource.data.readBy is list
        && request.resource.data.readBy.hasAll(resource.data.readBy)
        && (!resource.data.keys().hasAny(['deliveredTo'])
          || request.resource.data.deliveredTo.hasAll(resource.data.deliveredTo));
      allow delete: if isOwner();
    }

    match /memories/{memoryId} {
      allow read, create: if hasPrivateProfile();
      allow update, delete: if isOwner() || isCreator();
    }

    match /photos/{photoId} {
      allow read, create: if hasPrivateProfile();
      allow update, delete: if isOwner();
    }

    match /timeline/{entryId} {
      allow read, create: if hasPrivateProfile();
      allow update, delete: if isOwner() || isCreator();
    }

    match /letters/{letterId} {
      allow read, create: if hasPrivateProfile();
      allow update: if hasPrivateProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openedBy']);
      allow delete: if isOwner();
    }

    // Audio metadata and bytes are stored in Supabase behind the trusted music
    // API. Firestore holds intention-only room state, never audio URLs or
    // Spotify OAuth credentials.
    match /music_room/{roomId} {
      allow read: if hasPrivateProfile();
      allow create, update: if hasPrivateProfile()
        && request.resource.data.keys().hasOnly(['provider', 'trackId', 'playbackState', 'positionMs', 'updatedBy', 'updatedAt'])
        && request.resource.data.provider in ['private', 'spotify']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.positionMs is number;
      allow delete: if isOwner();
    }
  }
}
